{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Citizen profile data stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User identification UID" },
        "name": { "type": "string", "description": "Citizen full name" },
        "email": { "type": "string", "format": "email", "description": "Contact email" },
        "phone": { "type": "string", "description": "Citizen contact phone" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "ward": { "type": "string", "description": "Municipal ward zone" },
        "citizenId": { "type": "string", "description": "Unique civic registry ID" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Account role" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["uid", "name", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles keyed by their Firebase Auth UID"
    }
  }
}
